[user]
	name = Fredrik Jansson
[pull]
	rebase = true
[rebase]
	autoStash = true
[merge]
  conflictstyle = zdiff3
[push]
  autoSetupRemote = true
[init]
	defaultBranch = main
[rerere]
	enabled = true
[core]
	pager = delta
[diff]
	algorithm = histogram
[interactive]
  diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
